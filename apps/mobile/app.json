{
  "expo": {
    "name": "AgendaTimer",
    "slug": "agenda-timer",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "agendatimer",
    "platforms": ["android", "ios", "web"],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.agendatimer.app"
    },
    "ios": {
      "bundleIdentifier": "com.agendatimer.app"
    },
    "newArchEnabled": true,
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"]
  }
}
